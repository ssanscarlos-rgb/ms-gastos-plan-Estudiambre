          }
        }
      ]
    },
    {
      "name": "10. Error: monto negativo (400 con correlationId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/gastos",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Malo\",\n  \"monto\": -5,\n  \"categoria\": \"Comida\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error con status, message y correlationId\", () => {",
              "  const j = pm.response.json();",
              "  [\"status\",\"message\",\"correlationId\"].forEach(k => pm.expect(j).to.have.property(k));",
              "});"
            ]
          }
        }
      ]
    },
